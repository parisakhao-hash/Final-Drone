# คัดลอกเป็น .env แล้วแก้ค่า

# ---------- แหล่งข้อมูล ----------
# mock = ข้อมูลจำลอง, mavlink = ข้อมูลจริงจากโดรน
DATA_SOURCE=mock
# รับจาก QGroundControl forwarding
MAVLINK_URL=udpin:0.0.0.0:14445
# หรือ Pi ต่อสาย UART กับ flight controller โดยตรง
# MAVLINK_URL=/dev/serial0
# MAVLINK_BAUD=57600
DRONE_ID=relay-drone-01

# ---------- ฐานข้อมูล ----------
# sqlite = เก็บในเครื่อง, dynamodb = Amazon DynamoDB
STORAGE=sqlite
STORE_INTERVAL=2
AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=          (ห้าม commit key จริงขึ้น git)
# AWS_SECRET_ACCESS_KEY=
DDB_TELEMETRY_TABLE=drone_telemetry
DDB_ALERT_TABLE=drone_alerts
DDB_TTL_DAYS=30

# ---------- เกณฑ์ SOS ----------
BATTERY_WARN=30
BATTERY_LIMIT=20
BATTERY_SOS=10
MOTOR_IMBALANCE=35
MOTOR_TEMP_WARN=80
MOTOR_TEMP_MAX=100
BATTERY_TEMP_WARN=45
BATTERY_TEMP_MAX=55
PI_TEMP_WARN=70
PI_TEMP_MAX=80
ROUTER_TEMP_WARN=70
ROUTER_TEMP_MAX=85
GPS_MIN=6
SIGNAL_MIN=40
SIGNAL_CRITICAL=20
